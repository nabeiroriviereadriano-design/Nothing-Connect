;
; NcDisplay.inf - pilote d'ecran indirect de NOTHING CONNECT (IddCx, UMDF 2)
; Derive de IddSampleDriver.inf (Microsoft, MS-PL).
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=NcDisplay.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...19041

[Standard.NT$ARCH$.10.0...19041]
%DeviceName%=NcDisplay_Install, NothingConnectDisplay

[SourceDisksFiles]
NcDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[NcDisplay_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[NcDisplay_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=NcDisplay_HardwareDeviceSettings

[NcDisplay_HardwareDeviceSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"NothingConnectDisplayGroup"
; Les utilisateurs interactifs peuvent piloter l'ecran (IOCTL), sans droits administrateur.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[NcDisplay_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[NcDisplay_Install.NT.Wdf]
UmdfService=NcDisplay,NcDisplay_UmdfInstall
UmdfServiceOrder=NcDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[NcDisplay_UmdfInstall]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\NcDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
NcDisplay.dll

[Strings]
ManufacturerName="NOTHING CONNECT"
DiskName="NOTHING CONNECT Display Installation Disk"
DeviceName="NOTHING CONNECT - ecran du telephone"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
